ONM_EMAIL=
ONM_PASSWORD=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
CHECK_INTERVAL=600
DATA_DIR=.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
PROFILE_FILE=profile.md
TERMS_FILE=search_terms.txt
LINKEDIN_TERMS_FILE=search_terms_linkedin.txt
# Fontes ativas, separadas por vírgula: onm, gupy, indeed, linkedin
SOURCES=onm,gupy,indeed,linkedin
# Intervalo de cada fonte, em segundos. O ONM custa 1 requisição por ciclo e
# pode ser frequente; Gupy e Indeed custam uma POR TERMO de busca (~23); no
# LinkedIn cada vaga custa DUAS (busca + descrição), por isso ele é o mais
# espaçado. Piso de 60s em qualquer um.
INTERVAL_ONM=600
INTERVAL_GUPY=3600
INTERVAL_INDEED=3600
INTERVAL_LINKEDIN=7200

# --- Relatório diário ---
TIMEZONE=America/Sao_Paulo
REPORT_HOUR=22
# Para onde vai o relatório: "grupo" ou "privado"
REPORT_TO=grupo
# Só usado com REPORT_TO=privado. IDs de chat, separados por vírgula.
REPORT_CHAT_IDS=

# --- Volume e horário de publicação ---
# A vaga aprovada não vai direto ao grupo: entra numa fila com nota e o bot
# publica no máximo DAILY_LIMIT por dia, espaçadas dentro da janela. O que
# sobra concorre no dia seguinte, até vencer QUEUE_TTL_DAYS.
DAILY_LIMIT=8
SEND_WINDOW_START=6
SEND_WINDOW_END=23
QUEUE_TTL_DAYS=3
# Nota mínima (0-100) para uma vaga sequer entrar na fila. 0 = sem piso.
MIN_SCORE=0
# Quanto uma vaga PJ/freelance/por projeto ganha na disputa pela vaga do dia.
# Some-se à nota só para ordenar a fila; a nota de qualidade não muda.
# 100 = qualquer PJ passa na frente de qualquer CLT.  0 = preferência desligada.
# Vaga que não informa o regime nunca ganha o bônus.
# O painel sobrescreve este valor — mudar lá vale na hora, sem redeploy.
BONUS_REGIME_PJ=100

# --- Regras de corte ---
REJECT_ENGLISH=true
REJECT_SENIOR=true
# true = vaga que não DECLARA ser remota é descartada (pedido do Gabriel).
REQUIRE_EXPLICIT_REMOTE=true

# --- Apresentação no privado do bot ---
# Não existe mais nenhum comando administrativo. O bot só se apresenta.
SITE_URL=https://gabrielvitolla.com.br
INSTAGRAM_URL=https://instagram.com/gabriel.assistentevirtual
# @ do Telegram do Gabriel, para o botão de suporte. Sem @ inicial.
SUPORTE_TELEGRAM=

# --- Painel (admin.gabrielvitolla.com.br) ---
# Vazio = o bot roda exatamente igual, só não alimenta o dashboard.
DATABASE_URL=
